{
  "schemaVersion": 1,
  "id": "lysopen.agy",
  "name": "Antigravity ACP",
  "version": "0.1.2",
  "description": "Use the locally installed official agy ACP server as a PI-Desktop model provider.",
  "author": "lysopen",
  "homepage": "https://github.com/lysopen/PI-plugin-agy",
  "repository": "https://github.com/lysopen/PI-plugin-agy",
  "main": "main.cjs",
  "contributes": {
    "agentExtensions": ["agent-extension.mjs"],
    "providers": [
      {
        "id": "antigravity",
        "name": "Antigravity ACP",
        "vendorKey": "antigravity",
        "baseUrl": "http://127.0.0.1:17956/v1",
        "apiStyle": "chat_completions",
        "authKind": "none",
        "models": [
          {
            "id": "gemini-4-argon",
            "name": "Gemini 4 Argon",
            "contextWindow": 256000,
            "maxTokens": 8192,
            "thinkingLevels": ["low", "medium", "high"],
            "defaultThinkingLevel": "high"
          },
          {
            "id": "gemini-3.8-flash",
            "name": "Gemini 3.8 Flash",
            "contextWindow": 256000,
            "maxTokens": 8192,
            "thinkingLevels": ["low", "medium", "high"],
            "defaultThinkingLevel": "high"
          },
          {
            "id": "claude-opus-5-5",
            "name": "Claude Opus 5.5",
            "contextWindow": 256000,
            "maxTokens": 8192,
            "thinkingLevels": ["low", "medium", "high"],
            "defaultThinkingLevel": "high"
          },
          {
            "id": "claude-sonnet-5-5",
            "name": "Claude Sonnet 5.5",
            "contextWindow": 256000,
            "maxTokens": 8192,
            "thinkingLevels": ["low", "medium", "high"],
            "defaultThinkingLevel": "high"
          },
          {
            "id": "gpt-oss-120b-medium",
            "name": "GPT-OSS 120B (Medium)",
            "contextWindow": 131072,
            "maxTokens": 8192,
            "thinkingLevels": ["medium"],
            "defaultThinkingLevel": "medium"
          }
        ]
      }
    ],
    "services": [
      { "id": "antigravity-bridge", "label": "Antigravity OpenAI bridge" }
    ]
  },
  "permissions": ["agent.extension", "provider.register", "background.service"],
  "engines": {
    "piDesktop": ">=0.22.0"
  },
  "activationEvents": ["onStartup"],
  "i18n": {
    "en": {
      "name": "Antigravity ACP",
      "description": "Use the locally installed official agy ACP server as a PI-Desktop model provider.",
      "safetyNotes": "Runs the official local agy binary and keeps credentials in the official CLI account store."
    },
    "zh-CN": {
      "name": "Antigravity ACP",
      "description": "把本机官方 agy ACP 服务接入 PI-Desktop，提供 Gemini、Claude 和 GPT-OSS 模型。",
      "safetyNotes": "只启动本机官方 agy；登录态仍由官方 CLI 管理。"
    }
  }
}
